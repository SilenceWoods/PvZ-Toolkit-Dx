# ===========================================================================
# PvZ Toolkit Dx —— 上传 GitHub 用的 .gitignore
#
# 本目录已经**不包含**下面这些体积大 / 非本项目版权的内容；这里再列一遍，
# 是为了防止有人把开发工作区里的目录整体拷回来（尤其是 env/ 与 tool-src/ 的构建树）。
# ===========================================================================

# ---- 交付产物 / 快照（不属于源码） ----
build/
backup/

# ---- 构建环境（体积大，且都可以由 env/scripts/download_deps.py 重新取得） ----
env/mingw32/          # MinGW-w64 i686 工具链副本（约 900 MB）
env/src/              # 解压出来的第三方源码：FLTK（仅作 zlib 来源）/ ImGui / GLFW
env/downloads/        # download_deps.py 的下载缓存（约 280 MB）
env/fltk-build/       # 构建期辅助产物（本包不带 build_fltk.cmd，见 BUILD.md 第 1.3 节）
env/fltk32/           # zlib 安装前缀（libfltk_z.a 从这里取；不含 FLTK 本体）
env/glfw-build/
env/glfw32/           # GLFW 静态库安装前缀

# ---- 非本项目版权内容（不随源码发布） ----
game-src/             # 《植物大战僵尸》反编译源码（只作开发期参考）
AsmVsZombies-master/  # 第三方项目 AvZ（键控框架）源码

# ---- 编译中间产物与二进制 ----
*.obj
*.o
*.a
*.lib
*.dll
*.exe
*.pdb
*.res
*.ilk
*.exp

# ---- 运行期 / 测试产物 ----
*.zbl
*.log
pztk_hook_log.txt
zombies/

# ---- 压缩包与校验文件 ----
*.zip
*.tar.gz
*.7z
*.part
SHA256.txt

# ---- 编辑器 / 系统 ----
.vs/
*.user
*.suo
Thumbs.db
desktop.ini
